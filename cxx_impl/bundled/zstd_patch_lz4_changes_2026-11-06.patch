LZ4 v1.10.0 -> v1.11.0 introduced a change to the "contentChecksum_t" type.
It is apparently now known as "LZ4F_contentChecksum_t".

--- a/programs/fileio.c
+++ b/programs/fileio.c
@@ -1421,7 +1421,7 @@
     prefs.compressionLevel = compressionLevel;
     prefs.frameInfo.blockMode = LZ4F_blockLinked;
     prefs.frameInfo.blockSizeID = LZ4F_max64KB;
-    prefs.frameInfo.contentChecksumFlag = (contentChecksum_t)checksumFlag;
+    prefs.frameInfo.contentChecksumFlag = (LZ4F_contentChecksum_t)checksumFlag;
 #if LZ4_VERSION_NUMBER >= 10600
     prefs.frameInfo.contentSize = (srcFileSize==UTIL_FILESIZE_UNKNOWN) ? 0 : srcFileSize;
 #endif
